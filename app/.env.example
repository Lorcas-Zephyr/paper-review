# PostgreSQL / pgvector shared database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Compatibility names used by individual audit services
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Experiment audit database aliases
EXPERT_DB_HOST=127.0.0.1
EXPERT_DB_PORT=5432
EXPERT_DB_NAME=postgres
EXPERT_DB_USER=postgres
EXPERT_DB_PASSWORD=

# OpenAI-compatible LLM endpoint
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# AI scheduler (the planner falls back to a deterministic safe DAG if no key
# is present or the model returns invalid JSON)
ENABLE_AI_SCHEDULER=true
AI_PLANNER_MAX_TASKS=12
AI_PLANNER_MAX_ROUNDS=3
AI_PLANNER_TIMEOUT=45

# Local paper/reviewer corpus. Raw PDFs stay outside GitHub.
PAPERS_ROOT=E:/项目/大创/papers
PAPERS_MANIFEST=E:/项目/大创/papers/manifest.jsonl
DATASET_SPLIT_SEED=20260819

# Optional services
SERPAPI_KEY=
PDF_PARSE_API_URL=http://127.0.0.1:8000/file_parse
