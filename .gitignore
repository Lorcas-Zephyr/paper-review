# Secrets and local configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node
node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data and generated artifacts
**/log/
**/logs/
**/uploads/
**/outputs/
**/output/
**/reports/
**/results/
**/model_cache/
**/audit_result.json
*.log

# Local paper corpus (raw PDFs are not source-controlled). A generated JSONL
# manifest may be committed because it contains relative paths and metadata.
/papers/*
!/papers/manifest.jsonl
!/papers/README.md

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*
